rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Users Collection
    // Publicly readable so anyone can view stats on global leaderboards and friends can look up players.
    // Writable only by the authenticated owner of the profile.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. System Collection (for versioning and configuration)
    // Readable by everyone, writable only by the admin user (nana20201720@gmail.com)
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'nana20201720@gmail.com';
    }

    // 4. Custom Rooms Collection
    // Publicly readable so anyone (even unauthenticated guest users) can see the list of active public rooms.
    // Creating or joining/updating rooms requires authentication.
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 5. Invitations Collection
    // Read/write allowed for authenticated users.
    match /invitations/{inviteId} {
      allow read, write: if request.auth != null;
    }
  }
}
